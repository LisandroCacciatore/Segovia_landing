# Este proyecto funciona sin backend: el formulario abre WhatsApp con los datos.
# Si mas adelante queres recibir las consultas por API (Formspree, Resend, n8n),
# definí esta variable y el formulario hace POST ahi en vez de abrir WhatsApp.
VITE_FORM_ENDPOINT=

# Staging / previews: noindex + base path. En produccion dejar ambos vacios.
# `npm run build:staging` ya los setea por su cuenta.
VITE_NOINDEX=
VITE_BASE_PATH=
